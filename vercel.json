{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/admin",
      "destination": "/api/track-login?view=admin"
    }
  ],
  "crons": [
    {
      "path": "/api/tiktok-fetch",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/process-videos",
      "schedule": "0 7 * * *"
    }
  ]
}